# ─────────────────────────────────────────────────────────────────
#  Email Triage Agent — Local Configuration
#  Copy this file to .env and fill in your values.
#  .env is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────

# Your Azure AI Foundry project endpoint
# Found in: ai.azure.com → Your Project → Overview → Endpoint
# Format:  https://<resource>.services.ai.azure.com/api/projects/<ProjectName>
PROJECT_ENDPOINT=https://ananth-potlapalli-agent-resource.services.ai.azure.com/api/projects/ananth_potlapalli-agent

# Your deployed model name in Azure OpenAI
# Found in: ai.azure.com → Your Project → Models + Endpoints
MODEL_DEPLOYMENT_NAME=gpt-4o

# Persistent agent ID — populated after running: dotnet run -- bootstrap
# Leave empty on first run; the app will create the agent and print the ID.
AGENT_ID=asst_dAU7LToSMG2wn9a8Qn1X7ZDV
